# ── 시크릿 — 절대 커밋 금지 ─────────────────────────────────────────────
.automation/.gmail.env
.automation/.telegram.env
.env
*.env
*.key
*.pem

# ── 개인 데이터 ────────────────────────────────────────────────────────
# personal/ 은 자체 git(personal/.git)을 가진 별도 저장소다.
# 이 레포에 (gitlink 로도) 들어가면 안 된다.
personal/

# ── 회사 자산 — 이 레포는 2026-08-19 부로 개인 전용이다 ──────────────────
# 모노레포 로컬 참조본. 회사 코드이므로 개인 레포가 추적하지 않는다.
company-src/

# ── 휘발성 ─────────────────────────────────────────────────────────────
# 자동화 실행 로그 — 매 실행마다 갱신된다. 스크립트 자체는 계속 추적한다.
.automation/logs/

# OMC 런타임 상태 — 세션마다 새 JSON 이 생겨 폭증한다.
**/.omc/*
!**/.omc/skills/

# Obsidian 창 배치 — 기계마다 다르다
.obsidian/workspace.json

# macOS 파인더
.DS_Store

# gs-quant 등 무거운 의존성 — 재설치 가능하므로 추적하지 않는다
.automation/.venv/
